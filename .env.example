# ============================================================
# PEARLS AQI PREDICTOR v6
# Copy this file to .env and add your optional provider keys.
# Open-Meteo requires no API key for its public non-commercial API.
# ============================================================

APP_ENV=development
LOG_LEVEL=INFO
AQI_CITY=lahore
FORECAST_DAYS=3
BACKFILL_DAYS=730

API_TIMEOUT_SECONDS=120
API_RETRY_ATTEMPTS=6
REQUEST_PAUSE_SECONDS=3.0
BACKFILL_CHUNK_DAYS=14
BACKFILL_CACHE_ENABLED=true
BACKFILL_KEEP_CACHE=true
BACKFILL_SKIP_COMPLETE=true

RANDOM_SEED=42
MODEL_N_JOBS=1
MODEL_NAME=pearls_aqi_daily_ensemble
MODEL_VERSION=

# Honest production quality gates for the untouched DAILY test set.
MINIMUM_TEST_R2=0.70
MAXIMUM_TEST_RMSE=30.0
MINIMUM_DAY3_R2=0.45
GENERATE_EXPLAINABILITY=true
EXPLAINABILITY_SAMPLE_ROWS=180

# Open-Meteo is the required national historical/live provider.
# No Open-Meteo key is needed.
MINIMUM_PROVIDER_ROWS=24

# Optional real observation provider.
AQI_PROVIDER=openaq
OPENAQ_API_KEY=
OPENAQ_RADIUS_METERS=25000

# Optional live weather and air-pollution provider.
OPENWEATHER_API_KEY=

# Optional live AQI and 3–8 day forecast provider.
AQICN_API_TOKEN=

# Live forecast fusion weights. Missing providers are removed automatically.
PROVIDER_WEIGHT_MODEL=0.55
PROVIDER_WEIGHT_OPEN_METEO=0.30
PROVIDER_WEIGHT_OPENWEATHER=0.10
PROVIDER_WEIGHT_AQICN=0.05

# Local first. Change to hybrid after Hopsworks is configured.
FEATURE_STORE_BACKEND=local
HOPSWORKS_HOST=
HOPSWORKS_PORT=443
HOPSWORKS_PROJECT=
HOPSWORKS_API_KEY=
HOPSWORKS_FEATURE_GROUP_VERSION=9
HOPSWORKS_ONLINE_ENABLED=false
HOPSWORKS_REQUIRED=false
HOPSWORKS_SYNC_MODELS=true
RUNNING_IN_HOPSWORKS=false

API_REFRESH_TOKEN=
ALLOWED_ORIGINS=*

# Open-Meteo quota guard (conservative soft limits below the public ceilings)
API_QUOTA_MAX_PER_MINUTE=180
API_QUOTA_MAX_PER_HOUR=2800
API_QUOTA_MAX_PER_DAY=7500

# Leakage-safe OOF stacking
STACKING_ENABLED=true
STACKING_CV_FOLDS=3
STACKING_L2_REGULARIZATION=2.0
STACKING_MAX_ITERATIONS=2500
STACKING_MIN_IMPROVEMENT=0.001
STACKING_CITY_SHRINKAGE=60
STACKING_PROVINCE_SHRINKAGE=120

# v6.6 core-10 precision matrix validation
STACKING_MAX_BASE_MODELS=2
STACKING_MIN_COMPONENT_WEIGHT=0.02
STACKING_MEMORY_RECOVERY=true
STACKING_CITY_BALANCED=true
MATRIX_STRICT=true
MATRIX_MIN_ROWS_PER_CITY=1200
MATRIX_MIN_ISSUE_DATES=500
MATRIX_MIN_NUMERIC_FEATURES=60
MATRIX_MIN_FUTURE_WEATHER_COVERAGE=0.65
MATRIX_MAX_FEATURE_MISSING_RATIO=0.95
MATRIX_MAX_DUPLICATE_RATIO=0.0

CITY_SELECTION_ENABLED=true
CITY_SELECTION_TARGET_COUNT=8
CITY_SELECTION_CV_FOLDS=3
CITY_SELECTION_MIN_OOF_ROWS=450
CITY_SELECTION_MIN_BASELINE_GAIN=0.02
CITY_SELECTION_MANDATORY=karachi,multan
STACKING_RECENT_FOLD_WEIGHT=1.5

# Horizon-3 precision controls. These affect development OOF weighting only.
DAY3_RECENT_FOLD_WEIGHT=2.0
DAY3_EXTREME_SAMPLE_WEIGHT=1.25
DAY3_EXTREME_THRESHOLD=151
DAY3_STACKING_L2_REGULARIZATION=1.25

# v6.9 day-3 precision, bias guard, and champion/challenger registry
LOCAL_EXPERTS_ENABLED=true
LOCAL_EXPERT_CANDIDATES=ridge,hist_gradient,hist_gradient_long
LOCAL_EXPERT_MIN_ROWS=500
LOCAL_EXPERT_MIN_OOF_ROWS=180
LOCAL_EXPERT_MAX_WEIGHT=0.35
LOCAL_EXPERT_WEIGHT_SHRINKAGE=180
LOCAL_EXPERT_MIN_GAIN=0.005
LOCAL_EXPERT_MAX_CITIES_PER_TARGET=4
DAY3_LOCAL_EXPERT_MAX_WEIGHT=0.45
DAY3_LOCAL_EXPERT_MAX_CITIES=6
CALIBRATION_MONTH_SHRINKAGE=180
CALIBRATION_CITY_MONTH_SHRINKAGE=120
CALIBRATION_RECENT_CITY_ENABLED=true
CALIBRATION_RECENT_CITY_SHRINKAGE=180
CALIBRATION_BIAS_SHRINKAGE=240
DAY3_CALIBRATION_ENABLED=true
DAY3_CALIBRATION_MIN_RMSE_GAIN=0.001
DAY3_CALIBRATION_MAX_ABS_BIAS_REGRESSION=0.10
CHAMPION_MIN_R2_GAIN=0.0005
CHAMPION_MIN_RMSE_GAIN=0.05
CHAMPION_MAX_RMSE_REGRESSION=0.05
CHAMPION_MIN_DAY3_R2_GAIN=0.0005
CHAMPION_MAX_ABS_BIAS_REGRESSION=0.15
HOPSWORKS_CANDIDATE_MODEL_NAME=pearls_aqi_daily_ensemble_challengers
HOPSWORKS_FEATURE_GROUP_VERSION=9
